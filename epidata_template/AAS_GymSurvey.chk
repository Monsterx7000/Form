LABELBLOCK
  LABEL lbl_edu
    1 "Intermediate"
    2 "Secondary"
    3 "Institute"
    4 "University"
    9 "Missing / no answer"
  END
  LABEL lbl_yn
    1 "Yes"
    2 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_intent
    1 "Yes, I intend to use"
    2 "Maybe, not decided yet"
    3 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_age1
    1 "14-18"
    2 "19-25"
    3 "26-34"
    4 ">35"
    9 "Missing / no answer"
  END
  LABEL lbl_route
    1 "Mostly oral"
    2 "Mostly injection"
    3 "Both"
    9 "Missing / no answer"
  END
  LABEL lbl_admin
    1 "By myself alone"
    2 "With friends who also use"
    3 "At gym by a specialist"
    9 "Missing / no answer"
  END
  LABEL lbl_cycle
    1 "Once or twice in my life"
    2 "One cycle/year, 1-2 types"
    3 "One or more cycles/year, >2 types"
    9 "Missing / no answer"
  END
  LABEL lbl_need
    1 "Yes, must use to get results"
    2 "No, just trying"
    9 "Missing / no answer"
  END
  LABEL lbl_source
    1 "Friends at gym"
    2 "Gym trainer"
    3 "Hormone seller"
    4 "Internet"
    5 "Pharmacy or doctor"
    6 "Abroad when travelling"
    9 "Missing / no answer"
  END
  LABEL lbl_reason
    1 "Main reason"
    2 "Secondary reason"
    3 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_goal
    1 "Yes"
    2 "Less than I hoped"
    3 "Not yet"
    4 "No, got nothing I wanted"
    9 "Missing / no answer"
  END
  LABEL lbl_q13
    1 "Yes"
    2 "No"
    3 "A little"
    9 "Missing / no answer"
  END
  LABEL lbl_info
    1 "Most information"
    2 "Some information"
    3 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_avail
    1 "Yes, hard to obtain"
    2 "A little"
    3 "No, available and easy"
    9 "Missing / no answer"
  END
  LABEL lbl_attit
    1 "Encourage, if used correctly"
    2 "Wrong, should be banned"
    3 "Fine for those who learn how"
    4 "Don't know"
    5 "Harmful, better avoided"
    9 "Missing / no answer"
  END
  LABEL lbl_advice
    1 "Yes, gym trainer"
    2 "Yes, protein/supplement seller"
    3 "Yes, friend or gym member"
    4 "Yes, magazine or website"
    5 "No one advised me"
    9 "Missing / no answer"
  END
  LABEL lbl_yndk_ask
    1 "Yes"
    2 "No"
    3 "Don't know, would ask first"
    9 "Missing / no answer"
  END
  LABEL lbl_yndk
    1 "Yes"
    2 "No"
    3 "Don't know"
    9 "Missing / no answer"
  END
  LABEL lbl_agree
    1 "Disagree"
    2 "Don't know"
    3 "Agree a little"
    4 "Fully agree"
    9 "Missing / no answer"
  END
  LABEL lbl_true
    1 "Yes, true"
    2 "No, not true"
    3 "Don't know"
    9 "Missing / no answer"
  END
  LABEL lbl_tick
    0 "Not selected"
    1 "Selected"
    9 "Missing / no answer"
  END
  LABEL lbl_yndk2
    1 "Yes"
    2 "No"
    3 "Don't know"
    9 "Missing / no answer"
  END
  LABEL lbl_much
    1 "Yes, a lot"
    2 "Somewhat"
    3 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_rarely
    1 "Yes"
    2 "No or rarely"
    9 "Missing / no answer"
  END
  LABEL lbl_maybe
    1 "Yes"
    2 "Maybe, but not important"
    3 "No, I don't think so"
    9 "Missing / no answer"
  END
  LABEL lbl_often
    1 "Yes, often"
    2 "Yes, sometimes"
    3 "No"
    9 "Missing / no answer"
  END
  LABEL lbl_drink
    1 "Yes, that is my reason"
    2 "Sometimes"
    3 "No, not to help training"
    9 "Missing / no answer"
  END
END

